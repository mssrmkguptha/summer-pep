class Solution {
public:
   int dx[4]={1,-1,0,0};
   int dy[4]={0,0,1,-1};
   int original;
   int dfs(vector<vector<int>>& image,int i, int j,int m,int n){
       if(i<0 or j<0 or i>=m or j>=n or image[i][j]==0) return 0; 
      
       image[i][j]=0;
       int a=0;
      for(int itr=0;itr<4;itr++){
       a+=dfs(image,i+dx[itr],j+dy[itr],m,n);
      }


      return a+1;
   }
   int maxAreaOfIsland(vector<vector<int>>& grid) {
       int m=grid.size();
       int n=grid[0].size();
       int mx=0;
       for(int i=0;i<m;i++){
           for(int j=0;j<n;j++){
               if(grid[i][j]==1){
                  
                   mx=max(mx,dfs(grid,i,j,m,n));
               }
           }
       }
      return mx;
   }


};
