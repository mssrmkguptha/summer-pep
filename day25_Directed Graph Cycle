    }

    bool isCyclic(int V, vector<vector<int>> &edges) {

        vector<vector<int>> adj(V);

        for (auto &e : edges)
            adj[e[0]].push_back(e[1]);

        vis.assign(V, false);
        path.assign(V, false);

        for (int i = 0; i < V; i++) {
            if (!vis[i]) {
                if (dfs(adj, i))
                    return true;
            }
        }

        return false;
    }
};
