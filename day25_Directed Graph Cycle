class Solution {
  public:
    vector<bool> vis, path;

    bool dfs(vector<vector<int>> &adj, int node) {
        vis[node] = true;
        path[node] = true;

        for (int nbr : adj[node]) {
            if (!vis[nbr]) {
                if (dfs(adj, nbr))
                    return true;
            }
            else if (path[nbr]) {
                return true;
            }
        }

        path[node] = false;
